# Copy to app/.env and enter credentials; never commit app/.env.
# Required for source research; used for recognition/explanations when OpenRouter is not configured.
GEMINI_API_KEY=
# Optional: enables OpenRouter classification, vision recognition, and explanations.
OPENROUTER_API_KEY=
OPENROUTER_CLASSIFICATION_MODEL=typesafe/jev-1.13
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_EXPLANATION_MODEL=google/gemini-2.5-flash
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v1/context/organizations/YOUR_ORGANIZATION_ID/mcp/YOUR_ENDPOINT_NAME
SANITY_API_READ_TOKEN=
